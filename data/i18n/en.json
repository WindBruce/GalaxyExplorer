{
  "_comment": "English source strings for Galaxy Explorer. Keys are looked up with i18n.t(); {name} tokens are interpolated.",
  "app.name": "GALAXY EXPLORER",
  "app.tagline": "The galaxy was old before you arrived. Reconstruct what it forgot.",
